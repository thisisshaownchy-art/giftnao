# ==============================================================================
# GiftNao Public & Client Environment Variables
# Note: Copy this file to .env.local to configure your live credentials.
# ==============================================================================

# Supabase Project URL (from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anonymous Key (safe for client-side queries protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Store Meta
NEXT_PUBLIC_SITE_URL=https://giftnao.com
